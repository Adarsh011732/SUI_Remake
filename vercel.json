{
  "builds": [
    { "src": "ui/**", "use": "@vercel/static" },
    { "src": "api/**", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/startingpart(.*)", "status": 301, "headers": { "Location": "/index.html" } },
    { "src": "/startingpage(.*)", "status": 301, "headers": { "Location": "/index.html" } },
    { "src": "/home", "status": 301, "headers": { "Location": "/index.html" } },
    { "src": "/", "dest": "/ui/index.html" },
    { "src": "/compiler", "dest": "/ui/compiler.html" },
    { "src": "/deepbook", "dest": "/ui/deepbook.html" },
    { "src": "/deepbook-trade", "dest": "/ui/deepbook_trade.html" },
    { "src": "/deepbook-portfolio", "dest": "/ui/Deepbookv3ui/deepbookv3portfolio.html" },
    { "src": "/walrus-vault", "dest": "/ui/walrus_vault.html" },
    { "src": "/security-dashboard", "dest": "/ui/security_dashboard.html" },
    { "src": "/trade", "dest": "/ui/tradewindow.html" },
    { "src": "/wallet", "dest": "/ui/portfolio.html" },
    { "src": "/portfolio", "dest": "/ui/portfolio.html" },
    { "src": "/market", "dest": "/ui/market.html" },
    { "src": "/swap", "dest": "/ui/swap.html" },
    { "src": "/bridge", "dest": "/ui/bridge.html" },
    { "src": "/yield", "dest": "/ui/yield.html" },
    { "src": "/audit", "dest": "/ui/audit.html" },
    { "src": "/login", "dest": "/ui/loginpage.html" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/ui/$1" }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
